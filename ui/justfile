set shell := ["bash", "-cu"]

mvn := "../mvnw -f ../pom.xml -pl ui"

# Build the UI module and all required upstream modules.
build:
    {{mvn}} -am clean verify

# Test the UI module and all required upstream modules.
test:
    {{mvn}} -am test

# Remove UI module ui-build output.
clean:
    {{mvn}} clean

default:
    @just --list
