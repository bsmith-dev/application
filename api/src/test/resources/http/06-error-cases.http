###

# ── 400 Validation failures ───────────────────────────────────────────────────

### [400-1] Login — password below minimum length (min 8 chars)
# Expected: 400 Bad Request — Problem Details with constraint violation detail.

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "brian",
  "password": "short"
}

> {%
    client.test("Short login password returns 400", function () {
        client.assert(response.status === 400, `Expected 400 Bad Request but received ${response.status}`);
    });

    client.test("Short login password returns validation problem", function () {
        client.assert(response.contentType.mimeType === "application/problem+json", "Response content-type is not application/problem+json");
        client.assert(response.body.status === 400, `Expected problem status 400 but received ${response.body.status}`);
        client.assert(response.body.title === "Validation Failed", `Expected title 'Validation Failed' but received '${response.body.title}'`);
        client.assert(response.body.errors.hasOwnProperty("password"), "password validation error is missing");
    });
%}

###

### [400-2] Login — missing username field
# Expected: 400 Bad Request

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "password": "S3cure!pw"
}

> {%
    client.test("Missing login username returns 400", function () {
        client.assert(response.status === 400, `Expected 400 Bad Request but received ${response.status}`);
    });

    client.test("Missing login username returns validation problem", function () {
        client.assert(response.contentType.mimeType === "application/problem+json", "Response content-type is not application/problem+json");
        client.assert(response.body.title === "Validation Failed", `Expected title 'Validation Failed' but received '${response.body.title}'`);
        client.assert(response.body.errors.hasOwnProperty("username"), "username validation error is missing");
    });
%}

