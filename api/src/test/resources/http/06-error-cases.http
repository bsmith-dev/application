###

# ── 404 Not found ─────────────────────────────────────────────────────────────

### [404-1] Get group — valid UUID format but does not exist
# Expected: 404 Not Found — Problem Details body.

GET {{baseUrl}}/api/groups/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{$global.authToken || authToken}}

> {%
    client.test("Missing group returns 404", function () {
        client.assert(response.status === 404, `Expected 404 Not Found but received ${response.status}`);
    });

    client.test("Missing group returns not found problem", function () {
        client.assert(response.contentType.mimeType === "application/problem+json", "Response content-type is not application/problem+json");
        client.assert(response.body.status === 404, `Expected problem status 404 but received ${response.body.status}`);
        client.assert(response.body.title === "Group Not Found", `Expected title 'Group Not Found' but received '${response.body.title}'`);
    });
%}

