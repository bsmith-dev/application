# ── 400 Type / format mismatch ────────────────────────────────────────────────

### [400-11] Get group — groupId is not a valid UUID
# Expected: 400 Bad Request (MethodArgumentTypeMismatchException)

GET {{baseUrl}}/api/groups/not-a-uuid
Authorization: Bearer {{$global.authToken || authToken}}

> {%
    client.test("Invalid groupId format returns 400", function () {
        client.assert(response.status === 400, `Expected 400 Bad Request but received ${response.status}`);
    });

    client.test("Invalid groupId format returns invalid parameter problem", function () {
        client.assert(response.contentType.mimeType === "application/problem+json", "Response content-type is not application/problem+json");
        client.assert(response.body.status === 400, `Expected problem status 400 but received ${response.body.status}`);
        client.assert(response.body.title === "Invalid Parameter", `Expected title 'Invalid Parameter' but received '${response.body.title}'`);
    });
%}

