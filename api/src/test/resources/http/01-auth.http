# ─────────────────────────────────────────────────────────────────────────────
# 01-auth.http — Authentication: obtain JWT tokens for both members
#
# Run order: after 00-setup.http
#
# After running:
#   1. Copy the `token` from the primary login response
#      into http-client.env.json → "authToken"
#   2. Copy the `token` from the secondary login response
#      into http-client.env.json → "secondAuthToken"
#
# All subsequent files use {{authToken}} as the primary Bearer credential.
# 04-group-members.http uses {{secondAuthToken}} for cross-user scenarios.
#
# Public endpoint — no Authorization header required.
# ─────────────────────────────────────────────────────────────────────────────

### [1/2] Login as primary member (brian)
# Expected: 200 OK
# Response: { token }

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "brian",
  "password": "S3cure!pw"
}

> {%
    client.test("Primary login returns 200", function () {
        client.assert(response.status === 200, `Expected 200 OK but received ${response.status}`);
    });

    client.test("Primary login returns JSON", function () {
        client.assert(response.contentType.mimeType === "application/json", "Response content-type is not application/json");
    });

    client.test("Primary login returns a token", function () {
        client.assert(typeof response.body.token === "string" && response.body.token.length > 0, "token is missing");
    });

    if (response.status === 200 && response.body.token) {
        client.global.set("authToken", response.body.token);
    }
%}

###

### [2/2] Login as secondary member (bob)
# Expected: 200 OK
# Response: { token }

POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "bob",
  "password": "S3cure!pw"
}

> {%
    client.test("Secondary login returns 200", function () {
        client.assert(response.status === 200, `Expected 200 OK but received ${response.status}`);
    });

    client.test("Secondary login returns JSON", function () {
        client.assert(response.contentType.mimeType === "application/json", "Response content-type is not application/json");
    });

    client.test("Secondary login returns a token", function () {
        client.assert(typeof response.body.token === "string" && response.body.token.length > 0, "token is missing");
    });

    if (response.status === 200 && response.body.token) {
        client.global.set("secondAuthToken", response.body.token);
    }
%}
