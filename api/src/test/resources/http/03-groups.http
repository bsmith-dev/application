# ─────────────────────────────────────────────────────────────────────────────
# 03-groups.http — Group CRUD
#
# Run order: after 01-auth.http (authToken must be set in env)
#
# Covers:
#   GET  /api/groups           — list groups for authenticated member
#   POST /api/groups           — create a group
#   GET  /api/groups/{groupId} — fetch a single group by ID
#   PUT  /api/groups/{groupId} — rename a group
#   DELETE /api/groups/{groupId} — delete a group [OPTIONAL — teardown only]
#
# After running [2/5]:
#   Copy the returned groupId into http-client.env.json → "groupId"
#   All subsequent files (04, 05) depend on this value.
# ─────────────────────────────────────────────────────────────────────────────

### [1/5] List groups (empty baseline)
# Expected: 200 OK — empty array on a fresh database.

GET {{baseUrl}}/api/groups
Authorization: Bearer {{$global.authToken || authToken}}

> {%
    client.test("Initial group list returns 200", function () {
        client.assert(response.status === 200, `Expected 200 OK but received ${response.status}`);
    });

    client.test("Initial group list returns JSON array", function () {
        client.assert(response.contentType.mimeType === "application/json", "Response content-type is not application/json");
        client.assert(Array.isArray(response.body), "Response body is not an array");
    });
%}

###

### [2/5] Create a group
# Expected: 201 Created
# Response: { groupId, organizationId, name }
#
# The creator is automatically added as an ADMIN member of the group.

POST {{baseUrl}}/api/groups
Authorization: Bearer {{$global.authToken || authToken}}
Content-Type: application/json

{
  "name": "Smoke Test Group"
}

> {%
    client.test("Create group returns 201", function () {
        client.assert(response.status === 201, `Expected 201 Created but received ${response.status}`);
    });

    client.test("Create group returns JSON", function () {
        client.assert(response.contentType.mimeType === "application/json", "Response content-type is not application/json");
    });

    client.test("Create group returns expected body", function () {
        client.assert(response.body.name === "Smoke Test Group", `Expected group name 'Smoke Test Group' but received '${response.body.name}'`);
        client.assert(response.body.organizationId === client.global.get("organizationId"), "Group organizationId does not match created organization");
        client.assert(typeof response.body.groupId === "string" && response.body.groupId.length > 0, "groupId is missing");
    });

    if (response.status === 201 && response.body.groupId) {
        client.global.set("groupId", response.body.groupId);
    }
%}

###

### [3/5] List groups (should now contain the created group)
# Expected: 200 OK — array with one entry whose name is "Smoke Test Group".

GET {{baseUrl}}/api/groups
Authorization: Bearer {{$global.authToken || authToken}}

> {%
    client.test("Group list after create returns 200", function () {
        client.assert(response.status === 200, `Expected 200 OK but received ${response.status}`);
    });

    client.test("Group list after create includes created group", function () {
        client.assert(response.contentType.mimeType === "application/json", "Response content-type is not application/json");
        client.assert(Array.isArray(response.body), "Response body is not an array");
        const group = response.body.find(item => item.groupId === client.global.get("groupId"));
        client.assert(group !== undefined, "Created group is missing from group list");
        client.assert(group.name === "Smoke Test Group", `Expected group name 'Smoke Test Group' but received '${group && group.name}'`);
    });
%}

###

### [4/5] Get single group by ID
# Expected: 200 OK
# Response: { groupId, organizationId, name }
# Requires: groupId set in env from step [2/5]

GET {{baseUrl}}/api/groups/{{$global.groupId || groupId}}
Authorization: Bearer {{$global.authToken || authToken}}

> {%
    client.test("Get group returns 200", function () {
        client.assert(response.status === 200, `Expected 200 OK but received ${response.status}`);
    });

    client.test("Get group returns created group", function () {
        client.assert(response.contentType.mimeType === "application/json", "Response content-type is not application/json");
        client.assert(response.body.groupId === client.global.get("groupId"), "groupId does not match created group");
        client.assert(response.body.organizationId === client.global.get("organizationId"), "organizationId does not match created organization");
        client.assert(response.body.name === "Smoke Test Group", `Expected group name 'Smoke Test Group' but received '${response.body.name}'`);
    });
%}

###

### [5/5] Rename group
# Expected: 200 OK
# Response: { groupId, organizationId, name } with updated name.
# Requires: groupId set in env from step [2/5]

PUT {{baseUrl}}/api/groups/{{$global.groupId || groupId}}
Authorization: Bearer {{$global.authToken || authToken}}
Content-Type: application/json

{
  "name": "Smoke Test Group (renamed)"
}

> {%
    client.test("Rename group returns 200", function () {
        client.assert(response.status === 200, `Expected 200 OK but received ${response.status}`);
    });

    client.test("Rename group returns updated group", function () {
        client.assert(response.contentType.mimeType === "application/json", "Response content-type is not application/json");
        client.assert(response.body.groupId === client.global.get("groupId"), "groupId does not match created group");
        client.assert(response.body.name === "Smoke Test Group (renamed)", `Expected renamed group but received '${response.body.name}'`);
    });
%}

###

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL TEARDOWN — run only after all other smoke tests are complete.
# Deleting the group will cascade and break 04-group-members and 05-prompts
# if those have not already been run.
# ─────────────────────────────────────────────────────────────────────────────

# Manual teardown only. Keep this commented so `httpyac --all` does not delete
# the shared group before 04-group-members.http and 05-prompts.http run.
#
# DELETE {{baseUrl}}/api/groups/{{$global.groupId || groupId}}
# Authorization: Bearer {{$global.authToken || authToken}}
